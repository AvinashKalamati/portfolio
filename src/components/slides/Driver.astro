---
import { about, driver } from '../../data/content';
import { emphasize } from '../../lib/format';
import SlideHead from '../SlideHead.astro';
---

<section class="slide slide-driver" id="driver" data-slide aria-labelledby="driver-title">
  <div class="slide-inner">
    <div class="driver-grid">
      <div class="driver-intro">
        <SlideHead id="driver" />
        <p class="driver-headline">{about.headline}</p>
        <div class="driver-copy">
          {about.paragraphs.map((p) => <p set:html={emphasize(p)} />)}
        </div>
      </div>

      <div class="driver-sheet">
        <div class="sheet-head">
          <span class="sheet-num" aria-hidden="true">{driver.number}</span>
          <div>
            <p class="sheet-name">{driver.firstName} <b>{driver.lastName}</b></p>
            <p class="sheet-role">{driver.role}</p>
          </div>
        </div>
        <dl class="sheet-rows">
          {
            about.profile.map((row) => (
              <div class="sheet-row">
                <dt>{row.key}</dt>
                <dd>{row.value}</dd>
              </div>
            ))
          }
          <div class="sheet-row">
            <dt>Status</dt>
            <dd class="sheet-status">{driver.status}</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .driver-grid {
    display: grid;
    gap: 36px;
  }

  .driver-headline {
    margin: -8px 0 18px;
    font: 700 clamp(1.3rem, 2.2vw, 1.75rem)/1.2 var(--sans);
    color: var(--white);
  }

  .driver-copy {
    display: grid;
    gap: 14px;
    max-width: 62ch;
    font-size: 1.0625rem;
  }

  .driver-sheet {
    position: relative;
    align-self: center;
    background: var(--panel);
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent);
  }

  .sheet-head {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    border-bottom: 1px solid var(--line);
    background: linear-gradient(100deg, var(--accent-soft), transparent 60%);
  }
  .sheet-num {
    font: 900 52px/0.8 var(--sans);
    color: var(--accent);
    letter-spacing: -0.03em;
  }
  .sheet-name {
    font: 400 20px/1.1 var(--sans);
    text-transform: uppercase;
    color: var(--white);
  }
  .sheet-name b {
    font-weight: 900;
  }
  .sheet-role {
    margin-top: 4px;
    font: 600 11px/1.3 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .sheet-rows {
    margin: 0;
  }
  .sheet-row {
    display: grid;
    grid-template-columns: 124px 1fr;
    gap: 14px;
    padding: 10px 20px;
    border-bottom: 1px solid var(--line);
  }
  .sheet-row:nth-child(even) {
    background: rgb(255 255 255 / 0.015);
  }
  .sheet-row:last-child {
    border-bottom: 0;
  }
  .sheet-row dt {
    font: 700 10.5px/1.9 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .sheet-row dd {
    margin: 0;
    font-weight: 600;
    line-height: 1.45;
    color: var(--white);
  }
  .sheet-status {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--green) !important;
  }
  .sheet-status::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
  }

  @media (max-width: 480px) {
    .sheet-row {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }

  @media (min-width: 960px) {
    .driver-grid {
      grid-template-columns: minmax(0, 1fr) minmax(400px, 1fr);
      gap: clamp(32px, 4vw, 72px);
    }
  }

  @media (max-height: 820px) {
    :global(html.carousel) .driver-headline {
      margin-bottom: 12px;
    }
    :global(html.carousel) .driver-copy {
      gap: 10px;
      font-size: 1rem;
      line-height: 1.55;
    }
    :global(html.carousel) .sheet-head {
      padding: 12px 18px;
    }
    :global(html.carousel) .sheet-num {
      font-size: 40px;
    }
    :global(html.carousel) .sheet-row {
      padding: 6px 18px;
    }
  }
</style>
