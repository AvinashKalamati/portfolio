---
import { contact, driver } from '../../data/content';
import SlideHead from '../SlideHead.astro';

const bars = [4, 9, 14, 7, 18, 11, 22, 15, 8, 19, 12, 6, 16, 10, 20, 13, 5, 17, 9, 12, 7, 15, 10, 4];
const year = new Date().getFullYear();
---

<section class="slide slide-radio" id="contact" data-slide aria-labelledby="contact-title">
  <div class="slide-inner">
    <SlideHead id="contact" />

    <div class="radio carbon">
      <div class="radio-head">
        <span class="radio-live"><span aria-hidden="true"></span>Team radio</span>
        <span class="radio-channel">{driver.initials} {driver.number} → You</span>
        <svg class="radio-wave" viewBox="0 0 120 24" aria-hidden="true" preserveAspectRatio="none">
          {bars.map((h, i) => <rect x={i * 5} y={12 - h / 2} width="3" height={h} />)}
        </svg>
      </div>

      <blockquote class="radio-message">
        <p class="radio-quote">“{contact.headline}”</p>
        <p class="radio-text">{contact.message}</p>
      </blockquote>

      <ul class="radio-channels">
        {
          contact.channels.map((c) => (
            <li>
              <a
                class="channel"
                href={c.href}
                {...(c.external ? { target: '_blank', rel: 'noopener' } : {})}
              >
                <span class="channel-kind">
                  {c.label} <span aria-hidden="true">—</span> {c.kind}
                </span>
                <span class="channel-value">{c.value}</span>
                <span class="channel-note">{c.note}</span>
                <span class="channel-arrow" aria-hidden="true">
                  {c.external ? '↗' : '→'}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <footer class="site-foot">
      <span>© {year} {driver.name} · {driver.role}</span>
      <span>{driver.location} · Built with Astro · Unofficial fan styling, no team marks</span>
    </footer>
  </div>
</section>

<style>
  .radio {
    border: 1px solid var(--line-2);
    border-left: 4px solid var(--accent);
  }

  .radio-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    padding: 14px 22px;
    border-bottom: 1px solid var(--line);
    background: rgb(11 11 13 / 0.75);
  }
  .radio-live {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 10px;
    font: 700 11px/1 var(--mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-ink);
    background: var(--accent);
  }
  .radio-live span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }
  .radio-channel {
    font: 700 12px/1 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--white);
  }
  .radio-wave {
    flex: 1;
    min-width: 80px;
    max-width: 260px;
    height: 24px;
    margin-left: auto;
    fill: var(--accent);
    opacity: 0.8;
  }

  .radio-message {
    margin: 0;
    padding: 26px 22px 8px;
  }
  .radio-quote {
    font: 900 clamp(1.8rem, 4vw, 3rem)/1 var(--sans);
    text-transform: uppercase;
    color: var(--white);
  }
  .radio-text {
    margin-top: 14px;
    max-width: 62ch;
    font-size: 1.0625rem;
  }

  .radio-channels {
    display: grid;
    gap: 10px;
    padding: 18px 22px 22px;
  }
  .channel {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    padding: 16px 44px 16px 18px;
    text-decoration: none;
    background: rgb(11 11 13 / 0.85);
    border: 1px solid var(--line-2);
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }
  .channel:hover {
    border-color: var(--accent);
    background: var(--panel);
  }
  .channel-kind {
    font: 700 10.5px/1 var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .channel-value {
    font-weight: 700;
    color: var(--white);
    word-break: break-word;
    line-height: 1.3;
  }
  .channel-note {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .channel-arrow {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    font: 700 18px/1 var(--mono);
    color: var(--muted);
    transition:
      color 0.2s,
      transform 0.2s;
  }
  .channel:hover .channel-arrow {
    color: var(--accent);
    transform: translate(3px, -50%);
  }

  .site-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px;
    margin-top: 22px;
    font: 500 11.5px/1.5 var(--mono);
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  @media (min-width: 860px) {
    .radio-channels {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
