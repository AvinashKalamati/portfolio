---
import { skills } from '../../data/content';
import SlideHead from '../SlideHead.astro';
---

<section class="slide slide-skills" id="skills" data-slide aria-labelledby="skills-title">
  <div class="slide-inner">
    <SlideHead id="skills" lede={skills.lede} />

    <div class="setup-grid">
      {
        skills.groups.map((g, i) => (
          <section class="setup" aria-labelledby={`setup-${g.id}`}>
            <header class="setup-head">
              <span class="setup-index" data-index={String(i + 1).padStart(2, '0')} aria-hidden="true" />
              <div>
                <p class="setup-part">{g.part}</p>
                <h3 class="setup-name" id={`setup-${g.id}`}>
                  {g.name}
                </h3>
              </div>
              <span class="setup-note">{g.note}</span>
            </header>
            <ul class="setup-items">
              {g.items.map((item) => (
                <li class:list={['setup-item', { 'is-core': item.core }]}>{item.name}</li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
    <p class="setup-legend"><span class="setup-legend-swatch" aria-hidden="true"></span>Highlighted = core stack I use most</p>
  </div>
</section>

<style>
  .setup-grid {
    display: grid;
    gap: 14px;
  }

  .setup {
    position: relative;
    padding: 20px 22px 22px;
    background: var(--panel);
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .setup::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 60px;
    height: 3px;
    background: var(--accent);
  }

  .setup-head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    padding-bottom: 14px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }
  .setup-index::before {
    content: attr(data-index);
    font: 900 36px/0.9 var(--sans);
    color: transparent;
    -webkit-text-stroke: 1.5px var(--line-2);
  }
  .setup-part {
    font: 700 11px/1 var(--mono);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .setup-name {
    margin-top: 6px;
    font: 700 1.35rem/1.1 var(--sans);
    color: var(--white);
  }
  .setup-note {
    align-self: start;
    font: 500 11px/1.3 var(--mono);
    letter-spacing: 0.06em;
    color: var(--muted);
    text-align: right;
  }

  .setup-items {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .setup-item {
    padding: 7px 12px;
    font: 500 13px/1.2 var(--mono);
    color: var(--body);
    background: var(--asphalt);
    border: 1px solid var(--line-2);
  }
  .setup-item.is-core {
    color: var(--white);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .setup-legend {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
    font: 500 11.5px/1 var(--mono);
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .setup-legend-swatch {
    width: 14px;
    height: 14px;
    border: 1px solid var(--accent);
    background: var(--accent-soft);
  }

  @media (max-width: 480px) {
    .setup-note {
      display: none;
    }
    .setup-head {
      grid-template-columns: auto 1fr;
    }
  }

  @media (min-width: 860px) {
    .setup-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-height: 760px) {
    :global(html.carousel) .setup {
      padding: 14px 18px 16px;
    }
    :global(html.carousel) .setup-head {
      padding-bottom: 10px;
      margin-bottom: 12px;
    }
    :global(html.carousel) .setup-item {
      padding: 5px 10px;
    }
  }
</style>
