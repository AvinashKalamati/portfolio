---
import { experience } from '../../data/content';
import { emphasize } from '../../lib/format';
import SlideHead from '../SlideHead.astro';

const { rounds } = experience;
---

<section class="slide slide-experience" id="experience" data-slide aria-labelledby="experience-title">
  <div class="slide-inner">
    <SlideHead id="experience" lede={experience.lede} />

    <div class="calendar" data-rounds>
      <div class="calendar-strip" role="tablist" aria-label="Rounds">
        {
          rounds.map((r, i) => (
            <button
              type="button"
              class="round-tab"
              role="tab"
              id={`round-tab-${r.id}`}
              aria-controls={`round-${r.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-round-tab={i}
            >
              <span class="round-tab-num">R{r.round}</span>
              <span class="round-tab-text">
                <span class="round-tab-company">{r.company}</span>
                <span class="round-tab-dates">{r.dates}</span>
              </span>
            </button>
          ))
        }
      </div>

      <div class="rounds">
        {
          rounds.map((r, i) => (
            <div
              class:list={['round', { 'is-current': r.current }]}
              id={`round-${r.id}`}
              role="tabpanel"
              aria-labelledby={`round-tab-${r.id}`}
              data-round={i}
              data-active={i === 0 ? '' : undefined}
            >
              <div class="round-main">
                <div class="round-meta">
                  <span class="round-badge">
                    Round {r.round} <span aria-hidden="true">·</span> {r.tag}
                  </span>
                  <span class="round-dates">{r.dates}</span>
                </div>
                <h3 class="round-title">
                  {r.role}
                  <span class="round-company">
                    {r.company}
                    {r.client && <span class="round-client"> · client: {r.client}</span>}
                  </span>
                </h3>
                {r.summary && (
                  <p class="round-summary">
                    {r.summary} {r.quote && <em>“{r.quote}”</em>}
                  </p>
                )}
                <ul class="round-bullets">
                  {r.bullets.map((b) => (
                    <li set:html={emphasize(b)} />
                  ))}
                </ul>
                <ul class="chips round-chips" aria-label="Tech used">
                  {r.chips.map((c) => (
                    <li class="chip">{c}</li>
                  ))}
                </ul>
              </div>

              <aside class="round-timing" aria-label={`Key numbers — ${r.company}`}>
                <p class="timing-head">
                  <span>Pos</span>
                  <span>Result</span>
                </p>
                <ol class="timing-rows">
                  {r.stats.map((s, n) => (
                    <li class={`timing-row tone-${s.tone}`}>
                      <span class="timing-pos" aria-hidden="true">
                        {n + 1}
                      </span>
                      <span class="timing-value">
                        {s.value}
                        {s.unit && <small>{s.unit}</small>}
                      </span>
                      <span class="timing-label">{s.label}</span>
                    </li>
                  ))}
                </ol>
              </aside>
            </div>
          ))
        }
      </div>

      <div class="calendar-nav">
        <button type="button" class="btn calendar-btn" data-round-prev>
          <span aria-hidden="true">←</span> Previous round
        </button>
        <p class="calendar-count" aria-hidden="true">
          Round <b data-round-current>1</b> / {rounds.length}
        </p>
        <button type="button" class="btn calendar-btn" data-round-next>
          Next round <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .calendar-strip,
  .calendar-nav {
    display: none;
  }

  .rounds {
    display: grid;
    gap: 18px;
  }

  .round {
    display: grid;
    gap: 0;
    background: var(--panel);
    border: 1px solid var(--line);
    border-left: 3px solid var(--line-2);
  }
  .round.is-current {
    border-left-color: var(--accent);
  }

  .round-main {
    padding: 24px;
  }

  .round-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px;
    align-items: center;
  }
  .round-badge {
    padding: 5px 10px;
    font: 700 11px/1 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--white);
    background: var(--panel-2);
    border: 1px solid var(--line-2);
  }
  .round.is-current .round-badge {
    color: var(--accent-ink);
    background: var(--accent);
    border-color: var(--accent);
  }
  .round-dates {
    font: 700 12px/1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--white);
  }

  .round-title {
    margin-top: 16px;
    font: 700 clamp(1.35rem, 2.3vw, 1.8rem)/1.15 var(--sans);
    color: var(--white);
  }
  .round-company {
    display: block;
    margin-top: 4px;
    font-weight: 600;
    font-size: 0.78em;
    color: var(--body);
  }
  .round-client {
    color: var(--muted);
  }

  .round-summary {
    margin-top: 12px;
    max-width: 70ch;
  }
  .round-summary em {
    color: var(--white);
  }

  .round-bullets {
    display: grid;
    gap: 2px;
    margin-top: 14px;
  }
  .round-bullets li {
    position: relative;
    padding: 6px 0 6px 22px;
    border-top: 1px dashed var(--line);
    line-height: 1.5;
  }
  .round-bullets li:first-child {
    border-top: 0;
  }
  .round-bullets li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 15px;
    width: 10px;
    height: 3px;
    background: var(--accent);
    transform: skewX(-20deg);
  }

  .round-chips {
    margin-top: 16px;
  }

  /* Timing-tower stat box */
  .round-timing {
    padding: 18px 20px 20px;
    background: var(--asphalt);
    border-top: 1px solid var(--line);
  }
  .timing-head {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: 12px;
    padding-bottom: 8px;
    font: 700 10px/1 var(--mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid var(--line);
  }
  .timing-rows {
    display: grid;
  }
  .timing-row {
    display: grid;
    grid-template-columns: 26px auto 1fr;
    align-items: center;
    gap: 12px;
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
  }
  .timing-pos {
    display: grid;
    place-items: center;
    height: 22px;
    font: 700 12px/1 var(--mono);
    color: var(--bg);
    background: var(--white);
  }
  .timing-value {
    min-width: 76px;
    font: 700 18px/1 var(--mono);
    color: var(--tone);
    font-variant-numeric: tabular-nums;
  }
  .timing-value small {
    font-size: 0.7em;
  }
  .timing-label {
    font: 600 11px/1.3 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--body);
  }

  @media (min-width: 900px) {
    .round {
      grid-template-columns: minmax(0, 1fr) 300px;
    }
    .round-main {
      padding: 26px 30px;
    }
    .round-timing {
      border-top: 0;
      border-left: 1px solid var(--line);
    }
  }

  /* ---------- Carousel mode: nested round carousel ---------- */
  :global(html.carousel) .calendar-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
    margin-bottom: 14px;
  }
  :global(html.carousel) .round:not([data-active]) {
    display: none;
  }
  :global(html.carousel) .round[data-entering] {
    animation: round-in 0.45s var(--ease);
  }
  :global(html.carousel) .calendar-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 14px;
    margin-top: 14px;
  }

  .round-tab {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px 10px 10px;
    text-align: left;
    color: var(--body);
    background: var(--panel);
    border: 1px solid var(--line);
    border-bottom: 3px solid transparent;
    cursor: pointer;
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }
  .round-tab:hover {
    background: var(--panel-2);
  }
  .round-tab[aria-selected='true'] {
    color: var(--white);
    background: var(--panel-2);
    border-bottom-color: var(--accent);
  }
  .round-tab-num {
    font: 900 22px/1 var(--sans);
    color: var(--muted);
  }
  .round-tab[aria-selected='true'] .round-tab-num {
    color: var(--accent);
  }
  .round-tab-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .round-tab-company {
    font: 700 13px/1.2 var(--sans);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .round-tab-dates {
    font: 500 10.5px/1 var(--mono);
    letter-spacing: 0.06em;
    color: var(--muted);
    white-space: nowrap;
  }

  .calendar-btn {
    min-height: 40px;
    padding: 10px 18px;
    cursor: pointer;
  }
  .calendar-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .calendar-count {
    font: 700 12px/1 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .calendar-count b {
    color: var(--white);
  }

  @media (max-height: 820px) {
    :global(html.carousel) .calendar-strip {
      margin-bottom: 10px;
    }
    :global(html.carousel) .round-tab {
      padding-block: 7px;
    }
    :global(html.carousel) .round-main {
      padding: 18px 24px;
    }
    :global(html.carousel) .round-title {
      margin-top: 10px;
    }
    :global(html.carousel) .round-bullets {
      margin-top: 8px;
    }
    :global(html.carousel) .round-bullets li {
      padding-block: 4px;
    }
    :global(html.carousel) .round-chips {
      margin-top: 10px;
    }
    :global(html.carousel) .timing-row {
      padding: 6px 0;
    }
    :global(html.carousel) .calendar-nav {
      margin-top: 10px;
    }
    :global(html.carousel) .calendar-btn {
      min-height: 36px;
      padding-block: 8px;
    }
  }

  @media (max-height: 760px) {
    :global(html.carousel) .round-bullets li {
      line-height: 1.42;
    }
    :global(html.carousel) .round-tab-num {
      font-size: 18px;
    }
  }

  @keyframes round-in {
    from {
      opacity: 0;
      transform: translateX(24px);
    }
  }
</style>
