---
import { openSource, type Contribution } from '../../data/content';
import SlideHead from '../SlideHead.astro';

const steps: Record<string, string> = { P1: 'step-1', P2: 'step-2', P3: 'step-3' };
const cards: (Contribution & { step: string })[] = openSource.podium.map((c) => ({
  ...c,
  step: steps[c.position] ?? 'step-3',
}));
---

<section class="slide slide-podium" id="open-source" data-slide aria-labelledby="open-source-title">
  <div class="slide-inner">
    <SlideHead id="open-source" lede={openSource.lede} />

    <ol class="podium" aria-label="Open-source pull requests">
      {
        cards.map((c) => (
          <li class={`pod ${c.step}`}>
            <article class="pod-card">
              <p class="pod-pos">
                <b>{c.position}</b> {c.label}
              </p>
              <h3 class="pod-title">
                <a href={c.href} target="_blank" rel="noopener">
                  {c.title}
                </a>
              </h3>
              <p class="pod-repo">
                {c.repo} · {c.ref}
              </p>
              <p class="pod-desc">{c.description}</p>
              <div class="pod-foot">
                <span class={`badge tone-${c.statusTone}`}>{c.status}</span>
                <a class="pod-link" href={c.href} target="_blank" rel="noopener">
                  {c.linkLabel} <span aria-hidden="true">↗</span>
                  <span class="sr-only">
                    — {c.repo} {c.ref}
                  </span>
                </a>
              </div>
            </article>
            <div class="pod-step" aria-hidden="true">
              {c.position.replace('P', '')}
            </div>
          </li>
        ))
      }
    </ol>

    {
      openSource.pitLane.map((c) => (
        <article class="pitlane">
          <p class="pitlane-pos">
            <b>{c.position}</b> {c.label}
          </p>
          <div class="pitlane-body">
            <h3 class="pitlane-title">
              <a href={c.href} target="_blank" rel="noopener">
                {c.title}
              </a>
              <span class="pod-repo">
                {' '}
                {c.repo} · {c.ref}
              </span>
            </h3>
            <p class="pitlane-desc">{c.description}</p>
          </div>
          <span class={`badge tone-${c.statusTone}`}>{c.status}</span>
        </article>
      ))
    }
  </div>
</section>

<style>
  .podium {
    display: grid;
    gap: 14px;
  }

  .pod {
    display: flex;
    flex-direction: column;
  }

  .pod-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 20px 22px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-top: 3px solid var(--line-2);
  }
  .step-1 .pod-card {
    border-top-color: var(--accent);
  }

  .pod-pos {
    font: 700 11px/1 var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pod-pos b {
    margin-right: 8px;
    padding: 4px 8px;
    color: var(--bg);
    background: var(--white);
  }
  .step-1 .pod-pos b {
    color: var(--accent-ink);
    background: var(--accent);
  }

  .pod-title {
    margin-top: 14px;
    font: 700 1.2rem/1.25 var(--sans);
    color: var(--white);
  }
  .pod-title a,
  .pitlane-title a {
    text-decoration: none;
    background: linear-gradient(var(--accent), var(--accent)) 0 100% / 0 2px no-repeat;
    transition: background-size 0.25s;
  }
  .pod-title a:hover,
  .pitlane-title a:hover {
    background-size: 100% 2px;
  }

  .pod-repo {
    margin-top: 4px;
    font: 500 12px/1.4 var(--mono);
    color: var(--muted);
  }

  .pod-desc {
    margin-top: 10px;
    font-size: 0.94rem;
    line-height: 1.55;
  }

  .pod-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: auto;
    padding-top: 14px;
  }
  .pod-link {
    font: 700 12px/1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--white);
    padding-bottom: 3px;
    border-bottom: 2px solid var(--accent);
  }
  .pod-link:hover {
    color: var(--accent-text);
  }

  .pod-step {
    display: none;
  }

  .pitlane {
    display: grid;
    gap: 10px;
    margin-top: 14px;
    padding: 16px 20px;
    background: repeating-linear-gradient(-45deg, var(--asphalt) 0 12px, var(--panel) 12px 24px);
    border: 1px dashed var(--line-2);
  }
  .pitlane-pos {
    font: 700 11px/1 var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pitlane-pos b {
    margin-right: 8px;
    padding: 4px 8px;
    color: var(--bg);
    background: var(--yellow);
  }
  .pitlane-title {
    font: 700 1.05rem/1.3 var(--sans);
    color: var(--white);
  }
  .pitlane-title .pod-repo {
    font-weight: 500;
  }
  .pitlane-desc {
    margin-top: 4px;
    font-size: 0.92rem;
  }

  .slide-podium :global(.lede) {
    max-width: 90ch;
  }

  @media (min-width: 960px) {
    .podium {
      grid-template-columns: repeat(3, 1fr);
      align-items: end;
      gap: 12px;
    }
    .pod-card {
      padding: 18px 20px;
    }
    .pod-title {
      margin-top: 12px;
    }
    .pod-desc {
      font-size: 0.9rem;
      line-height: 1.5;
    }
    .step-2 {
      order: 1;
    }
    .step-1 {
      order: 2;
    }
    .step-3 {
      order: 3;
    }
    .pod-step {
      display: grid;
      place-items: center;
      font: 900 30px/1 var(--sans);
      color: var(--muted);
      background: linear-gradient(180deg, var(--panel-2), var(--asphalt));
      border: 1px solid var(--line);
      border-top: 0;
    }
    .step-1 .pod-step {
      height: 48px;
      color: var(--accent-ink);
      background: var(--accent);
      border-color: var(--accent);
    }
    .step-2 .pod-step {
      height: 34px;
      font-size: 24px;
    }
    .step-3 .pod-step {
      height: 22px;
      font-size: 18px;
    }
    .pitlane {
      grid-template-columns: 200px 1fr;
      grid-template-rows: auto auto;
      align-items: start;
      gap: 8px 20px;
      padding: 14px 20px;
    }
    .pitlane > .badge {
      grid-column: 1;
      grid-row: 2;
      justify-self: start;
    }
    .pitlane-body {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    .pitlane-desc {
      font-size: 0.88rem;
    }
  }

  @media (min-width: 960px) and (max-height: 820px) {
    .pod-card {
      padding: 14px 18px;
    }
    .pod-desc {
      font-size: 0.86rem;
    }
    .pod-foot {
      padding-top: 10px;
    }
    .step-1 .pod-step {
      height: 34px;
      font-size: 24px;
    }
    .step-2 .pod-step {
      height: 24px;
      font-size: 18px;
    }
    .step-3 .pod-step {
      height: 16px;
      font-size: 13px;
    }
    .pitlane {
      margin-top: 10px;
      padding: 10px 18px;
    }
  }

  @media (min-width: 960px) and (max-height: 760px) {
    .pod-title {
      margin-top: 8px;
      font-size: 1.08rem;
    }
    .pod-desc {
      margin-top: 6px;
      line-height: 1.45;
    }
    .pod-step {
      display: none !important;
    }
    .pitlane-desc {
      font-size: 0.84rem;
      line-height: 1.45;
    }
  }
</style>
